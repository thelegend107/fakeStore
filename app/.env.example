# Copy to .env.local for local development (never commit real keys).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: previous project URL if copied rows still store full avatar/storage URLs under that host.
# If omitted, any *.supabase.co/storage/v1/object/ URL from another project is rewritten to VITE_SUPABASE_URL.
# VITE_SUPABASE_LEGACY_URL=https://previous-project-ref.supabase.co

VITE_BEST_BUY_API_KEY=
VITE_ENCRYPTION_KEY=
